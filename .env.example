OPENSHEET_TOKENS_CLOCK_SKEW=60s
# tokens.supportedAlgs
OPENSHEET_TOKENS_SUPPORTED_ALGS=RS256,ES256
# tokens.acceptRS256
OPENSHEET_TOKENS_ACCEPT_RS256=

# ── cloud only ──
# [required, mode:cloud] tokens.issuer
OPENSHEET_TOKENS_ISSUER=
# [required, mode:cloud] tokens.jwksURL
OPENSHEET_TOKENS_JWKS_URL=
