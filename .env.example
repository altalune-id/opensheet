# opensheet — auto-generated from internal/platform/config struct tags.
# DO NOT edit by hand. Run `go tool gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot (in the applicable mode)
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#   mode:X     — only applies in the given mode (selfhosted | cloud)
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them via env vars after first boot has NO effect on already-
#     persisted data (e.g., db.driver is set at first migration; switching
#     from sqlite→postgres requires a full data migration, not an env flip).
#   - Some fields are secrets used to sign existing tokens/cookies
#     (http.stateSecret) — rotating invalidates in-flight sessions.
#   - Some fields are database-layer decisions (schema, tablePrefix) that
#     require SQL-level intervention to change.
#
# Read every line here BEFORE first `opensheet serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── cache ───
# [bootstrap] cache.driver
OPENSHEET_CACHE_DRIVER=auto

# ─── db ───
# [required, bootstrap] db.driver
OPENSHEET_DB_DRIVER=sqlite
# [bootstrap] db.schema
OPENSHEET_DB_SCHEMA=public
# [bootstrap] db.tablePrefix
OPENSHEET_DB_TABLE_PREFIX=altempl_
# [bootstrap] db.role
OPENSHEET_DB_ROLE=
# [secret, bootstrap] db.migrator.dsn
OPENSHEET_DB_MIGRATOR_DSN=
# [bootstrap] db.migrator.role
OPENSHEET_DB_MIGRATOR_ROLE=
# [bootstrap] db.reader.role
OPENSHEET_DB_READER_ROLE=
# [bootstrap] db.allowBypassRLS
OPENSHEET_DB_ALLOW_BYPASS_RLS=

# ─── genesis ───
# [bootstrap, secret] genesis.password
OPENSHEET_GENESIS_PASSWORD=

# ── cloud only ──
# [bootstrap, mode:cloud] genesis.breakGlass
OPENSHEET_GENESIS_BREAK_GLASS=false

# ─── http ───

# ── cloud only ──
# [required, mode:cloud, secret, bootstrap] http.stateSecret
OPENSHEET_HTTP_STATE_SECRET=

# ─── i18n ───
# [required, bootstrap] i18n.defaultLocale
OPENSHEET_I18N_DEFAULT_LOCALE=en-US

# ─── log ───
# [bootstrap] log.redactPatterns
OPENSHEET_LOG_REDACT_PATTERNS=

# ─── mode ───
# [required, bootstrap] mode
OPENSHEET_MODE=selfhosted

# ─── scheduler ───
# [bootstrap] scheduler.enabled
OPENSHEET_SCHEDULER_ENABLED=true
# [bootstrap] scheduler.timezone
OPENSHEET_SCHEDULER_TIMEZONE=UTC

# ─── security ───

# ── cloud only ──
# [required, mode:cloud, secret, bootstrap] security.encryptionKey
OPENSHEET_SECURITY_ENCRYPTION_KEY=

# ─── sheets ───
# [bootstrap] sheets.publicEnabled
OPENSHEET_SHEETS_PUBLIC_ENABLED=false

# ─── tenant ───
# [bootstrap] tenant.rlsEnforce
OPENSHEET_TENANT_RLS_ENFORCE=true
# [bootstrap] tenant.singletonOrg.slug
OPENSHEET_TENANT_SINGLETON_ORG_SLUG=default
# [bootstrap] tenant.singletonOrg.name
OPENSHEET_TENANT_SINGLETON_ORG_NAME=Default Organization
# [bootstrap] tenant.tenantScopedTables
OPENSHEET_TENANT_TENANT_SCOPED_TABLES=

# ─── tokens ───

# ── cloud only ──
# [required, mode:cloud, bootstrap] tokens.audience
OPENSHEET_TOKENS_AUDIENCE=urn:opensheet:api


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.enabled
OPENSHEET_API_ENABLED=true
# api.openapi.enabled
OPENSHEET_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
OPENSHEET_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
OPENSHEET_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
OPENSHEET_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── cache ───
# cache.defaultTTL
OPENSHEET_CACHE_DEFAULT_TTL=30s
# cache.maxBytes
OPENSHEET_CACHE_MAX_BYTES=67108864

# ─── compliance ───
# compliance.termsURL
OPENSHEET_COMPLIANCE_TERMS_URL=
# compliance.privacyURL
OPENSHEET_COMPLIANCE_PRIVACY_URL=
# compliance.requireAcceptance
OPENSHEET_COMPLIANCE_REQUIRE_ACCEPTANCE=

# ─── db ───
# [required, secret] db.dsn
OPENSHEET_DB_DSN=
# [secret] db.reader.dsn
OPENSHEET_DB_READER_DSN=
# db.reader.maxOpenConns
OPENSHEET_DB_READER_MAX_OPEN_CONNS=
# db.reader.maxIdleConns
OPENSHEET_DB_READER_MAX_IDLE_CONNS=
# db.reader.connMaxLifetime
OPENSHEET_DB_READER_CONN_MAX_LIFETIME=
# db.reader.connMaxIdleTime
OPENSHEET_DB_READER_CONN_MAX_IDLE_TIME=
# db.health.interval
OPENSHEET_DB_HEALTH_INTERVAL=30s
# db.health.timeout
OPENSHEET_DB_HEALTH_TIMEOUT=2s
# db.autoMigrate
OPENSHEET_DB_AUTO_MIGRATE=true
# db.maxOpenConns
OPENSHEET_DB_MAX_OPEN_CONNS=
# db.maxIdleConns
OPENSHEET_DB_MAX_IDLE_CONNS=
# db.connMaxLifetime
OPENSHEET_DB_CONN_MAX_LIFETIME=
# db.connMaxIdleTime
OPENSHEET_DB_CONN_MAX_IDLE_TIME=
# db.connectTimeout
OPENSHEET_DB_CONNECT_TIMEOUT=30s
# db.connectBackoff
OPENSHEET_DB_CONNECT_BACKOFF=250ms

# ─── genesis ───
# genesis.email
OPENSHEET_GENESIS_EMAIL=

# ─── google ───
# google.timeout
OPENSHEET_GOOGLE_TIMEOUT=15s

# ── cloud only ──
# [required, mode:cloud] google.oauth.clientID
OPENSHEET_GOOGLE_OAUTH_CLIENT_ID=
# [required, mode:cloud, secret] google.oauth.clientSecret
OPENSHEET_GOOGLE_OAUTH_CLIENT_SECRET=
# [required, mode:cloud] google.picker.apiKey
OPENSHEET_GOOGLE_PICKER_API_KEY=

# ─── http ───
# [required] http.addr
OPENSHEET_HTTP_ADDR=:5150
# http.basePath
OPENSHEET_HTTP_BASE_PATH=
# [required] http.baseURL
OPENSHEET_HTTP_BASE_URL=
# http.cookieSecure
OPENSHEET_HTTP_COOKIE_SECURE=false
# http.robotsTxt
OPENSHEET_HTTP_ROBOTS_TXT=

# ─── log ───
# log.level
OPENSHEET_LOG_LEVEL=info
# log.format
OPENSHEET_LOG_FORMAT=json
# log.addSource
OPENSHEET_LOG_ADD_SOURCE=

# ─── mail ───
# mail.driver
OPENSHEET_MAIL_DRIVER=console
# mail.from
OPENSHEET_MAIL_FROM=no-reply@opensheet.local
# mail.smtp.host
OPENSHEET_MAIL_SMTP_HOST=
# mail.smtp.port
OPENSHEET_MAIL_SMTP_PORT=587
# mail.smtp.user
OPENSHEET_MAIL_SMTP_USER=
# [secret] mail.smtp.pass
OPENSHEET_MAIL_SMTP_PASS=
# mail.smtp.tls
OPENSHEET_MAIL_SMTP_TLS=true
# [secret] mail.resend.apiKey
OPENSHEET_MAIL_RESEND_API_KEY=
# mail.resend.endpoint
OPENSHEET_MAIL_RESEND_ENDPOINT=
# mail.resend.maxAttempts
OPENSHEET_MAIL_RESEND_MAX_ATTEMPTS=3

# ─── observability ───
# observability.reporter.minSeverity
OPENSHEET_OBSERVABILITY_REPORTER_MIN_SEVERITY=error
# observability.reporter.sinks
OPENSHEET_OBSERVABILITY_REPORTER_SINKS=

# ─── oidc ───
# oidc.resource
OPENSHEET_OIDC_RESOURCE=
# oidc.scopes
OPENSHEET_OIDC_SCOPES=openid,email,profile
# oidc.redirectPort
OPENSHEET_OIDC_REDIRECT_PORT=
# oidc.buttonLabel
OPENSHEET_OIDC_BUTTON_LABEL=
# oidc.buttonLogoURL
OPENSHEET_OIDC_BUTTON_LOGO_URL=
# oidc.endSessionOnLogout
OPENSHEET_OIDC_END_SESSION_ON_LOGOUT=

# ── cloud only ──
# [required, mode:cloud] oidc.issuer
OPENSHEET_OIDC_ISSUER=
# [required, mode:cloud] oidc.clientID
OPENSHEET_OIDC_CLIENT_ID=
# [required, mode:cloud, secret] oidc.clientSecret
OPENSHEET_OIDC_CLIENT_SECRET=

# ─── onboard ───
# [secret] onboard.setupToken
OPENSHEET_ONBOARD_SETUP_TOKEN=

# ─── scheduler ───
# scheduler.shutdownGrace
OPENSHEET_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── session ───
# session.path
OPENSHEET_SESSION_PATH=~/.opensheet/session.json

# ─── sheets ───
# sheets.maxPayloadBytes
OPENSHEET_SHEETS_MAX_PAYLOAD_BYTES=8388608

# ─── telemetry ───
# telemetry.otlp.endpoint
OPENSHEET_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
OPENSHEET_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
OPENSHEET_TELEMETRY_OTLP_INSECURE=
# [secret] telemetry.otlp.headers
OPENSHEET_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
OPENSHEET_TELEMETRY_TRACING_ENABLED=false
# telemetry.tracing.sampleRatio
OPENSHEET_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
OPENSHEET_TELEMETRY_METRICS_ENABLED=false
# telemetry.metrics.exportInterval
OPENSHEET_TELEMETRY_METRICS_EXPORT_INTERVAL=30s
# telemetry.metrics.prometheus.enabled
OPENSHEET_TELEMETRY_METRICS_PROMETHEUS_ENABLED=false
# telemetry.metrics.prometheus.addr
OPENSHEET_TELEMETRY_METRICS_PROMETHEUS_ADDR=:9091
