OPENSHEET_TELEMETRY_METRICS_PROMETHEUS_PATH=/metrics

# ─── tenant ───
# tenant.personalOrgSlugFallback
OPENSHEET_TENANT_PERSONAL_ORG_SLUG_FALLBACK=personal
# tenant.personalProjectSlug
OPENSHEET_TENANT_PERSONAL_PROJECT_SLUG=default

# ─── tokens ───
# tokens.jwksCacheTTL
OPENSHEET_TOKENS_JWKS_CACHE_TTL=
