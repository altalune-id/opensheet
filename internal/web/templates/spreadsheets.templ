package templates

import (
	"altalune.id/opensheet/internal/web"
	"altalune.id/opensheet/internal/web/icons"
)

// OptionRow is one entry of a select control, shared by the opensheet pages.
type OptionRow struct {
	Value string
	Label string
}

type SpreadsheetRow struct {
	ID             string
	Title          string
	GoogleFileID   string
	CredentialName string
	Writable       bool
}

type SpreadsheetsView struct {
	ProjectSlug  string
	Rows         []SpreadsheetRow
	Credentials  []OptionRow
	CredentialID string
	GoogleFileID string
	Title        string
	PickerURL    string
	Error        string
	ErrorCode    string
}

type SpreadsheetView struct {
	ProjectSlug  string
	ID           string
	Title        string
	GoogleFileID string
	CredentialID string
	Credentials  []OptionRow
	Writable     bool
	Error        string
	ErrorCode    string
}

// BulkTabRow is one publishable tab of a document in the bulk publish panel.
type BulkTabRow struct {
	Tab         string
	TabValue    string
	SlugField   string
	Slug        string
	SheetID     string
	Published   bool
	Created     bool
	SlugEmpty   bool
	Failure     string
	FailureCode string
}

// BulkPublishView is the tab-picker panel rendered on a spreadsheet's detail page.
type BulkPublishView struct {
	ProjectSlug     string
	SpreadsheetID   string
	CacheTTL        string
	Public          bool
	Rows            []BulkTabRow
	Manual          BulkTabRow
	Unavailable     string
	UnavailableCode string
	NoneSelected    bool
	Notice          string
}

templ SpreadsheetSection(d web.LayoutData, v SpreadsheetsView) {
	<section id="spreadsheets-section">
		if v.Error != "" {
			<div data-error="spreadsheets">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		if len(v.Credentials) == 0 {
			<div class="mt-6 rounded-lg border border-dashed border-border bg-card p-8 text-center">
				<p class="text-sm text-muted-foreground">{ d.Tr("spreadsheets.needs_credential") }</p>
				<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/credentials")) } class="mt-4 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">{ d.Tr("nav.credentials") }</a>
			</div>
		} else {
			<form
				method="post"
				action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets")) }
				hx-post={ d.ProjectPath(v.ProjectSlug, "/spreadsheets") }
				hx-target="#spreadsheets-section"
				hx-swap="outerHTML"
				class="mt-6 rounded-lg border border-border bg-card p-4 shadow-sm"
			>
				<h2 class="text-sm font-semibold text-foreground">{ d.Tr("spreadsheets.register_heading") }</h2>
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("spreadsheets.register_subtitle") }</p>
				<div class="mt-4 grid gap-4 sm:grid-cols-3">
					<div class="sm:col-span-2">
						<label for="spreadsheet-file" class="block text-sm font-medium text-foreground/90">{ d.Tr("spreadsheets.file_id") }</label>
						<input id="spreadsheet-file" name="google_file_id" type="text" required value={ v.GoogleFileID } placeholder={ d.Tr("spreadsheets.file_id_placeholder") } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 font-mono text-xs text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
						<p class="mt-1.5 text-xs text-muted-foreground">{ d.Tr("spreadsheets.file_id_hint") }</p>
					</div>
					<div>
						<label for="spreadsheet-credential" class="block text-sm font-medium text-foreground/90">{ d.Tr("nav.credentials") }</label>
						<select id="spreadsheet-credential" name="credential_id" required class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring">
							for _, c := range v.Credentials {
								<option value={ c.Value } selected?={ c.Value == v.CredentialID }>{ c.Label }</option>
							}
						</select>
					</div>
				</div>
				<div class="mt-4">
					<label for="spreadsheet-title" class="block text-sm font-medium text-foreground/90">{ d.Tr("spreadsheets.title_label") }</label>
					<input id="spreadsheet-title" name="title" type="text" value={ v.Title } placeholder={ d.Tr("spreadsheets.title_placeholder") } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
				</div>
				<div class="mt-4 flex items-center gap-3">
					<button type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
						@icons.Icon("plus", "h-4 w-4")
						<span>{ d.Tr("spreadsheets.register_submit") }</span>
					</button>
					if v.PickerURL != "" {
						<a href={ templ.SafeURL(v.PickerURL) } class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
							@icons.Icon("file-spreadsheet", "h-4 w-4")
							<span>{ d.Tr("spreadsheets.pick_from_drive") }</span>
						</a>
					}
				</div>
			</form>
		}
		if len(v.Rows) == 0 {
			<div data-empty="spreadsheets" class="mt-6 rounded-lg border border-dashed border-border bg-card p-8 text-center">
				<p class="text-sm text-muted-foreground">{ d.Tr("spreadsheets.empty") }</p>
			</div>
		} else {
			<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
				for _, s := range v.Rows {
					<li>
						<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+s.ID)) } class="group flex items-center gap-3 px-4 py-3 hover:bg-muted/60">
							<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-border bg-background text-muted-foreground group-hover:text-foreground">
								@icons.Icon("file-spreadsheet", "h-4 w-4")
							</span>
							<span class="min-w-0 flex-1">
								<span class="truncate text-sm font-medium text-foreground">{ s.Title }</span>
								<span class="mt-0.5 block truncate font-mono text-xs text-muted-foreground">{ s.GoogleFileID }</span>
							</span>
							if s.Writable {
								<span data-spreadsheet-writable-badge class="inline-flex shrink-0 items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300">{ d.Tr("spreadsheets.writable_badge") }</span>
							}
							<span class="hidden shrink-0 text-xs text-muted-foreground sm:block">{ s.CredentialName }</span>
							@icons.Icon("chevron-right", "h-4 w-4 shrink-0 text-muted-foreground/50")
						</a>
					</li>
				}
			</ul>
		}
	</section>
}

templ SpreadsheetsPage(d web.LayoutData, v SpreadsheetsView) {
	<div>
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("nav.spreadsheets") }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("spreadsheets.subtitle") }</p>
		</header>
		@SpreadsheetSection(d, v)
	</div>
}

templ SpreadsheetsLayout(d web.LayoutData, v SpreadsheetsView) {
	@Layout(web.WithContent(d, SpreadsheetsPage(d, v)))
}

templ SpreadsheetPage(d web.LayoutData, v SpreadsheetView) {
	<div class="mx-auto max-w-2xl">
		<header class="border-b border-border pb-4">
			<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets")) } class="text-xs text-muted-foreground hover:text-foreground">{ "← " + d.Tr("nav.spreadsheets") }</a>
			<h1 class="mt-2 text-2xl font-semibold text-foreground">{ v.Title }</h1>
			<p class="mt-1 font-mono text-xs text-muted-foreground">{ v.GoogleFileID }</p>
		</header>
		if v.Error != "" {
			<div data-error="spreadsheet">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+v.ID)) } class="mt-6 space-y-4 rounded-lg border border-border bg-card p-4 shadow-sm">
			<div>
				<label for="spreadsheet-edit-title" class="block text-sm font-medium text-foreground/90">{ d.Tr("spreadsheets.title_label") }</label>
				<input id="spreadsheet-edit-title" name="title" type="text" value={ v.Title } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
			</div>
			<div>
				<label for="spreadsheet-edit-credential" class="block text-sm font-medium text-foreground/90">{ d.Tr("nav.credentials") }</label>
				<select id="spreadsheet-edit-credential" name="credential_id" class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring">
					for _, c := range v.Credentials {
						<option value={ c.Value } selected?={ c.Value == v.CredentialID }>{ c.Label }</option>
					}
				</select>
			</div>
			@spreadsheetWritableField(d, v.Writable)
			<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">{ d.Tr("common.save") }</button>
		</form>
		<div class="mt-6 rounded-lg border border-border bg-card p-4 shadow-sm">
			<h2 class="text-sm font-semibold text-foreground">{ d.Tr("spreadsheets.tabs_heading") }</h2>
			<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("spreadsheets.tabs_subtitle") }</p>
			<div
				id="spreadsheet-tabs"
				hx-get={ d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+v.ID+"/tabs") }
				hx-trigger="load"
				hx-swap="innerHTML"
				class="mt-3 text-sm text-muted-foreground"
			>
				{ d.Tr("common.loading") }
			</div>
		</div>
		<div
			id="spreadsheet-bulk-publish"
			hx-get={ d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+v.ID+"/publish") }
			hx-trigger="load"
			hx-swap="outerHTML"
			class="mt-6 rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground shadow-sm"
		>
			{ d.Tr("common.loading") }
		</div>
		<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+v.ID+"/delete")) } class="mt-6">
			<button type="submit" class={ dangerButton }>
				@icons.Icon("trash-2", "h-4 w-4")
				<span>{ d.Tr("spreadsheets.delete") }</span>
			</button>
		</form>
	</div>
}

// SECURITY: the flag is enforced on the server; this checkbox only carries the operator's intent.
templ spreadsheetWritableField(d web.LayoutData, writable bool) {
	<fieldset>
		<label class="flex items-start gap-2 text-sm text-foreground">
			<input data-spreadsheet-writable type="checkbox" name="writable" value="1" checked?={ writable } class="mt-0.5 size-4"/>
			<span>
				{ d.Tr("spreadsheets.writable") }
				<span class="mt-0.5 block text-xs text-muted-foreground">{ d.Tr("spreadsheets.writable_hint") }</span>
			</span>
		</label>
	</fieldset>
}

templ SpreadsheetLayout(d web.LayoutData, v SpreadsheetView) {
	@Layout(web.WithContent(d, SpreadsheetPage(d, v)))
}

// SpreadsheetTabs is the HTMX partial listing a document's tabs, which is a Google round-trip.
templ SpreadsheetTabs(d web.LayoutData, tabs []string, failure, code string) {
	if failure != "" {
		<div data-error="tabs">
			@ErrorBanner(d, failure, code)
		</div>
	} else if len(tabs) == 0 {
		<p class="text-sm text-muted-foreground">{ d.Tr("spreadsheets.tabs_empty") }</p>
	} else {
		<ul class="flex flex-wrap gap-2">
			for _, t := range tabs {
				<li class="rounded-full border border-border bg-background px-2.5 py-1 font-mono text-xs text-foreground">{ t }</li>
			}
		</ul>
	}
}

// SpreadsheetBulkPublish is the HTMX panel that publishes several of a document's tabs in one action.
templ SpreadsheetBulkPublish(d web.LayoutData, v BulkPublishView) {
	<section id="spreadsheet-bulk-publish" class="mt-6 rounded-lg border border-border bg-card p-4 shadow-sm">
		<h2 class="text-sm font-semibold text-foreground">{ d.Tr("spreadsheets.bulk_heading") }</h2>
		<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("spreadsheets.bulk_subtitle") }</p>
		if v.Notice != "" {
			<p data-notice="bulk" class="mt-3 text-xs text-red-600 dark:text-red-400">{ v.Notice }</p>
		}
		if v.NoneSelected {
			<p data-notice="bulk-none-selected" class="mt-3 text-xs text-red-600 dark:text-red-400">{ d.Tr("spreadsheets.bulk_none_selected") }</p>
		}
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+v.SpreadsheetID+"/publish")) }
			hx-post={ d.ProjectPath(v.ProjectSlug, "/spreadsheets/"+v.SpreadsheetID+"/publish") }
			hx-target="#spreadsheet-bulk-publish"
			hx-swap="outerHTML"
			class="mt-4"
		>
			if v.Unavailable != "" {
				<p data-notice="bulk-tabs-unavailable" class="text-xs text-amber-700 dark:text-amber-400">{ d.Tr("spreadsheets.bulk_tabs_unavailable") }</p>
				@ErrorBanner(d, v.Unavailable, v.UnavailableCode)
				<div class="mt-3 grid gap-3 sm:grid-cols-2">
					<div>
						<label for="bulk-manual-tab" class="block text-sm font-medium text-foreground/90">{ d.Tr("sheets.tab") }</label>
						<input id="bulk-manual-tab" name="tab_name" type="text" value={ v.Manual.Tab } placeholder={ d.Tr("sheets.tab_placeholder") } class={ bulkInput }/>
					</div>
					<div>
						<label for="bulk-manual-slug" class="block text-sm font-medium text-foreground/90">{ d.Tr("common.slug") }</label>
						<input id="bulk-manual-slug" name="slug" type="text" value={ v.Manual.Slug } placeholder={ d.Tr("sheets.slug_placeholder") } class={ bulkInput }/>
						if v.Manual.SlugEmpty {
							<p data-outcome="failed" class={ bulkFailure }>{ d.Tr("spreadsheets.bulk_slug_empty") }</p>
						}
						if v.Manual.Failure != "" {
							<p data-outcome="failed" class={ bulkFailure }>
								{ v.Manual.Failure }
								if v.Manual.FailureCode != "" {
									<span class="ml-1 font-mono">{ "(" + v.Manual.FailureCode + ")" }</span>
								}
							</p>
						}
						if v.Manual.Created {
							<p data-outcome="published" class="mt-1.5 text-xs text-muted-foreground">{ d.Tr("spreadsheets.bulk_published") }</p>
						}
					</div>
				</div>
			} else if len(v.Rows) == 0 {
				<p class="text-xs text-muted-foreground">{ d.Tr("spreadsheets.tabs_empty") }</p>
			} else {
				<ul class="divide-y divide-border/50 overflow-hidden rounded-md border border-border">
					for _, row := range v.Rows {
						<li class="flex flex-wrap items-center gap-3 px-3 py-2">
							<input type="checkbox" name="tab" value={ row.TabValue } disabled?={ row.Published } class="size-4"/>
							<span class="min-w-0 flex-1 truncate font-mono text-xs text-foreground">{ row.Tab }</span>
							if row.Published {
								<span class="text-xs text-muted-foreground">
									if row.Created {
										{ d.Tr("spreadsheets.bulk_published") }
									} else {
										{ d.Tr("spreadsheets.bulk_already") }
									}
								</span>
								if row.SheetID != "" {
									<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/sheets/"+row.SheetID)) } class="text-xs text-muted-foreground underline hover:text-foreground">{ d.Tr("common.open") }</a>
								}
							} else {
								<input type="text" name={ row.SlugField } value={ row.Slug } placeholder={ d.Tr("sheets.slug_placeholder") } class="w-48 rounded-md border border-border bg-background px-2.5 py-1.5 font-mono text-xs text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
								if row.SlugEmpty {
									<span data-outcome="failed" class="text-xs text-red-600 dark:text-red-400">{ d.Tr("spreadsheets.bulk_slug_empty") }</span>
								}
								if row.Failure != "" {
									<span data-outcome="failed" class="text-xs text-red-600 dark:text-red-400">{ row.Failure }</span>
								}
							}
						</li>
					}
				</ul>
			}
			@visibilityFields(d, v.Public)
			<div class="mt-4 sm:max-w-xs">
				<label for="bulk-ttl" class="block text-sm font-medium text-foreground/90">{ d.Tr("sheets.cache_ttl") }</label>
				<input id="bulk-ttl" name="cache_ttl" type="number" min="0" max="86400" step="1" value={ v.CacheTTL } class={ bulkInput }/>
				<p class="mt-1.5 text-xs text-muted-foreground">{ d.Tr("sheets.cache_ttl_hint") }</p>
			</div>
			<button type="submit" class="mt-4 inline-flex items-center gap-2 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
				@icons.Icon("plus", "h-4 w-4")
				<span>{ d.Tr("spreadsheets.bulk_submit") }</span>
			</button>
		</form>
	</section>
}

const (
	bulkInput   = "mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"
	bulkFailure = "mt-1.5 text-xs text-red-600 dark:text-red-400"
)
