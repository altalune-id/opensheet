package templates

import (
	"altalune.id/opensheet/internal/web"
	"altalune.id/opensheet/internal/web/icons"
)

// OptionRow is one entry of a select control, shared by the opensheet pages.
type OptionRow struct {
	Value string
	Label string
}

type SpreadsheetRow struct {
	ID             string
	Title          string
	GoogleFileID   string
	CredentialName string
}

type SpreadsheetsView struct {
	ProjectSlug  string
	Rows         []SpreadsheetRow
	Credentials  []OptionRow
	CredentialID string
	GoogleFileID string
	Title        string
	PickerURL    string
	Error        string
	ErrorCode    string
}

type SpreadsheetView struct {
	ProjectSlug  string
	ID           string
	Title        string
	GoogleFileID string
	CredentialID string
	Credentials  []OptionRow
	Error        string
	ErrorCode    string
}

templ SpreadsheetSection(d web.LayoutData, v SpreadsheetsView) {
	<section id="spreadsheets-section">
		if v.Error != "" {
			<div data-error="spreadsheets">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		if len(v.Credentials) == 0 {
			<div class="mt-6 rounded-lg border border-dashed border-border bg-card p-8 text-center">
				<p class="text-sm text-muted-foreground">{ d.Tr("spreadsheets.needs_credential") }</p>
				<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/credentials")) } class="mt-4 inline-block rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">{ d.Tr("nav.credentials") }</a>
			</div>
		} else {
			<form
				method="post"
				action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets")) }
				hx-post={ d.ProjectPath(v.ProjectSlug, "/spreadsheets") }
				hx-target="#spreadsheets-section"
				hx-swap="outerHTML"
				class="mt-6 rounded-lg border border-border bg-card p-4 shadow-sm"
			>
				<h2 class="text-sm font-semibold text-foreground">{ d.Tr("spreadsheets.register_heading") }</h2>
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("spreadsheets.register_subtitle") }</p>
				<div class="mt-4 grid gap-4 sm:grid-cols-3">
					<div class="sm:col-span-2">
						<label for="spreadsheet-file" class="block text-sm font-medium text-foreground/90">{ d.Tr("spreadsheets.file_id") }</label>
						<input id="spreadsheet-file" name="google_file_id" type="text" required value={ v.GoogleFileID } placeholder={ d.Tr("spreadsheets.file_id_placeholder") } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 font-mono text-xs text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
						<p class="mt-1.5 text-xs text-muted-foreground">{ d.Tr("spreadsheets.file_id_hint") }</p>
					</div>
					<div>
						<label for="spreadsheet-credential" class="block text-sm font-medium text-foreground/90">{ d.Tr("nav.credentials") }</label>
						<select id="spreadsheet-credential" name="credential_id" required class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring">
							for _, c := range v.Credentials {
								<option value={ c.Value } selected?={ c.Value == v.CredentialID }>{ c.Label }</option>
							}
						</select>
					</div>
				</div>
				<div class="mt-4">
					<label for="spreadsheet-title" class="block text-sm font-medium text-foreground/90">{ d.Tr("spreadsheets.title_label") }</label>
					<input id="spreadsheet-title" name="title" type="text" value={ v.Title } placeholder={ d.Tr("spreadsheets.title_placeholder") } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
				</div>
				<div class="mt-4 flex items-center gap-3">
					<button type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
						@icons.Icon("plus", "h-4 w-4")
						<span>{ d.Tr("spreadsheets.register_submit") }</span>
					</button>
					if v.PickerURL != "" {
						<a href={ templ.SafeURL(v.PickerURL) } class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
							@icons.Icon("file-spreadsheet", "h-4 w-4")
							<span>{ d.Tr("spreadsheets.pick_from_drive") }</span>
						</a>
					}
				</div>
			</form>
		}
		if len(v.Rows) == 0 {
			<div data-empty="spreadsheets" class="mt-6 rounded-lg border border-dashed border-border bg-card p-8 text-center">
				<p class="text-sm text-muted-foreground">{ d.Tr("spreadsheets.empty") }</p>
			</div>
		} else {
			<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
				for _, s := range v.Rows {
					<li>
						<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/" + s.ID)) } class="group flex items-center gap-3 px-4 py-3 hover:bg-muted/60">
							<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-border bg-background text-muted-foreground group-hover:text-foreground">
								@icons.Icon("file-spreadsheet", "h-4 w-4")
							</span>
							<span class="min-w-0 flex-1">
								<span class="truncate text-sm font-medium text-foreground">{ s.Title }</span>
								<span class="mt-0.5 block truncate font-mono text-xs text-muted-foreground">{ s.GoogleFileID }</span>
							</span>
							<span class="hidden shrink-0 text-xs text-muted-foreground sm:block">{ s.CredentialName }</span>
							@icons.Icon("chevron-right", "h-4 w-4 shrink-0 text-muted-foreground/50")
						</a>
					</li>
				}
			</ul>
		}
	</section>
}

templ SpreadsheetsPage(d web.LayoutData, v SpreadsheetsView) {
	<div>
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("nav.spreadsheets") }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("spreadsheets.subtitle") }</p>
		</header>
		@SpreadsheetSection(d, v)
	</div>
}

templ SpreadsheetsLayout(d web.LayoutData, v SpreadsheetsView) {
	@Layout(web.WithContent(d, SpreadsheetsPage(d, v)))
}

templ SpreadsheetPage(d web.LayoutData, v SpreadsheetView) {
	<div class="mx-auto max-w-2xl">
		<header class="border-b border-border pb-4">
			<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets")) } class="text-xs text-muted-foreground hover:text-foreground">{ "← " + d.Tr("nav.spreadsheets") }</a>
			<h1 class="mt-2 text-2xl font-semibold text-foreground">{ v.Title }</h1>
			<p class="mt-1 font-mono text-xs text-muted-foreground">{ v.GoogleFileID }</p>
		</header>
		if v.Error != "" {
			<div data-error="spreadsheet">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/" + v.ID)) } class="mt-6 space-y-4 rounded-lg border border-border bg-card p-4 shadow-sm">
			<div>
				<label for="spreadsheet-edit-title" class="block text-sm font-medium text-foreground/90">{ d.Tr("spreadsheets.title_label") }</label>
				<input id="spreadsheet-edit-title" name="title" type="text" value={ v.Title } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
			</div>
			<div>
				<label for="spreadsheet-edit-credential" class="block text-sm font-medium text-foreground/90">{ d.Tr("nav.credentials") }</label>
				<select id="spreadsheet-edit-credential" name="credential_id" class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring">
					for _, c := range v.Credentials {
						<option value={ c.Value } selected?={ c.Value == v.CredentialID }>{ c.Label }</option>
					}
				</select>
			</div>
			<button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">{ d.Tr("common.save") }</button>
		</form>
		<div class="mt-6 rounded-lg border border-border bg-card p-4 shadow-sm">
			<h2 class="text-sm font-semibold text-foreground">{ d.Tr("spreadsheets.tabs_heading") }</h2>
			<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("spreadsheets.tabs_subtitle") }</p>
			<div
				id="spreadsheet-tabs"
				hx-get={ d.ProjectPath(v.ProjectSlug, "/spreadsheets/" + v.ID + "/tabs") }
				hx-trigger="load"
				hx-swap="innerHTML"
				class="mt-3 text-sm text-muted-foreground"
			>
				{ d.Tr("common.loading") }
			</div>
		</div>
		<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/spreadsheets/" + v.ID + "/delete")) } class="mt-6">
			<button type="submit" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-red-600">
				@icons.Icon("trash-2", "h-4 w-4")
				<span>{ d.Tr("spreadsheets.delete") }</span>
			</button>
		</form>
	</div>
}

templ SpreadsheetLayout(d web.LayoutData, v SpreadsheetView) {
	@Layout(web.WithContent(d, SpreadsheetPage(d, v)))
}

// SpreadsheetTabs is the HTMX partial listing a document's tabs, which is a Google round-trip.
templ SpreadsheetTabs(d web.LayoutData, tabs []string, failure string) {
	if failure != "" {
		<p data-error="tabs" class="text-sm text-red-600 dark:text-red-400">{ failure }</p>
	} else if len(tabs) == 0 {
		<p class="text-sm text-muted-foreground">{ d.Tr("spreadsheets.tabs_empty") }</p>
	} else {
		<ul class="flex flex-wrap gap-2">
			for _, t := range tabs {
				<li class="rounded-full border border-border bg-background px-2.5 py-1 font-mono text-xs text-foreground">{ t }</li>
			}
		</ul>
	}
}
