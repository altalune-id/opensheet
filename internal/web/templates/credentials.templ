package templates

import (
	"altalune.id/opensheet/internal/web"
	"altalune.id/opensheet/internal/web/icons"
)

type CredentialRow struct {
	ID           string
	Name         string
	KindLabel    string
	Account      string
	CreatedAt    string
	NeedsReauth  bool
	CanReconnect bool
}

type CredentialsView struct {
	ProjectSlug      string
	Rows             []CredentialRow
	Name             string
	Error            string
	ErrorCode        string
	StoredUnverified bool
}

templ CredentialSection(d web.LayoutData, v CredentialsView) {
	<section id="credentials-section">
		if v.Error != "" {
			<div data-error="credentials">
				@ErrorBanner(d, v.Error, v.ErrorCode)
			</div>
		}
		if v.StoredUnverified {
			<p data-notice="credential-stored-unverified" class="mt-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-200">
				@icons.Icon("triangle-alert", "mr-1.5 inline h-4 w-4 align-text-bottom")
				{ d.Tr("credentials.stored_unverified") }
			</p>
		}
		<div class={ "mt-6 grid gap-6", templ.KV("lg:grid-cols-2", d.Caps.GoogleConnect) }>
			<form
				method="post"
				action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/credentials")) }
				hx-post={ d.ProjectPath(v.ProjectSlug, "/credentials") }
				hx-encoding="multipart/form-data"
				hx-target="#credentials-section"
				hx-swap="outerHTML"
				enctype="multipart/form-data"
				data-upload="service-account"
				class="rounded-lg border border-border bg-card p-4 shadow-sm"
			>
				<h2 class="text-sm font-semibold text-foreground">{ d.Tr("credentials.upload_heading") }</h2>
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("credentials.upload_subtitle") }</p>
				<div class={ "mt-4 grid gap-4", templ.KV("sm:grid-cols-2", !d.Caps.GoogleConnect) }>
					<div>
						<label for="credential-name" class="block text-sm font-medium text-foreground/90">{ d.Tr("common.name") }</label>
						<input id="credential-name" name="name" type="text" required value={ v.Name } placeholder={ d.Tr("credentials.name_placeholder") } class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"/>
					</div>
					<div>
						<label for="credential-key" class="block text-sm font-medium text-foreground/90">{ d.Tr("credentials.key_file") }</label>
						<input id="credential-key" name="key" type="file" accept="application/json,.json" class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 text-sm text-foreground shadow-sm"/>
					</div>
				</div>
				<label for="credential-key-json" class="mt-4 block text-sm font-medium text-foreground/90">{ d.Tr("credentials.key_paste") }</label>
				<textarea id="credential-key-json" name="key_json" rows="4" placeholder="{&#34;type&#34;:&#34;service_account&#34;,…}" class="mt-1.5 block w-full rounded-md border border-border bg-background px-3 py-2 font-mono text-xs text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring"></textarea>
				<button type="submit" class="mt-4 inline-flex items-center gap-2 rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
					@icons.Icon("upload", "h-4 w-4")
					<span>{ d.Tr("credentials.upload_submit") }</span>
				</button>
			</form>
			if d.Caps.GoogleConnect {
				<form
					method="post"
					action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/credentials/google/start")) }
					class="rounded-lg border border-border bg-card p-4 shadow-sm"
				>
					<h2 class="text-sm font-semibold text-foreground">{ d.Tr("credentials.connect_heading") }</h2>
					<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("credentials.connect_subtitle") }</p>
					<button type="submit" class="mt-4 inline-flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm font-medium text-foreground shadow-sm hover:bg-muted">
						@icons.Icon("external-link", "h-4 w-4")
						<span>{ d.Tr("credentials.connect_submit") }</span>
					</button>
				</form>
			}
		</div>
		if len(v.Rows) == 0 {
			<div data-empty="credentials" class="mt-6 rounded-lg border border-dashed border-border bg-card p-8 text-center">
				if d.Caps.GoogleConnect {
					<p class="text-sm text-muted-foreground">{ d.Tr("credentials.empty") }</p>
				} else {
					<p class="text-sm text-muted-foreground">{ d.Tr("credentials.empty_upload_only") }</p>
				}
			</div>
		} else {
			<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
				for _, c := range v.Rows {
					<li class="flex items-center gap-3 px-4 py-3">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-border bg-background text-muted-foreground">
							@icons.Icon("shield", "h-4 w-4")
						</span>
						<span class="min-w-0 flex-1">
							<span class="flex items-center gap-2">
								<span class="truncate text-sm font-medium text-foreground">{ c.Name }</span>
								if c.NeedsReauth {
									<span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300">{ d.Tr("credentials.status_reauth") }</span>
								}
							</span>
							<span class="mt-0.5 block truncate text-xs text-muted-foreground">
								{ c.KindLabel }
								if c.Account != "" {
									{ " · " + c.Account }
								}
								{ " · " + c.CreatedAt }
							</span>
						</span>
						if c.CanReconnect && d.Caps.GoogleConnect {
							<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/credentials/google/start")) } class="inline">
								<button type="submit" class="rounded p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label={ d.Tr("credentials.reconnect") }>
									@icons.Icon("refresh-cw", "h-4 w-4")
								</button>
							</form>
						}
						<form
							method="post"
							action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/credentials/" + c.ID + "/delete")) }
							hx-post={ d.ProjectPath(v.ProjectSlug, "/credentials/" + c.ID + "/delete") }
							hx-target="#credentials-section"
							hx-swap="outerHTML"
							hx-confirm={ d.Tr("credentials.delete_confirm") }
							class="inline"
						>
							<button type="submit" class={ dangerIconButton } aria-label={ d.Tr("common.delete") }>
								@icons.Icon("trash-2", "h-4 w-4")
							</button>
						</form>
					</li>
				}
			</ul>
		}
	</section>
}

templ CredentialsPage(d web.LayoutData, v CredentialsView) {
	<div>
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("nav.credentials") }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("credentials.subtitle") }</p>
		</header>
		@CredentialSection(d, v)
	</div>
}

templ CredentialsLayout(d web.LayoutData, v CredentialsView) {
	@Layout(web.WithContent(d, CredentialsPage(d, v)))
}
