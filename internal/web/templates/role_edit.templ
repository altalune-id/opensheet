package templates

import (
	"strconv"

	"altalune.id/opensheet/internal/web"
)

// PermOption is one checkbox in the role permission grid.
type PermOption struct {
	Value   string
	Label   string
	Checked bool
}

type RoleEditView struct {
	OrgSlug     string
	ID          string
	Name        string
	Description string
	Version     int64
	Perms       []PermOption
	Stale       bool
	Error       string
	ErrorCode   string
}

func (v RoleEditView) action(d web.LayoutData) string {
	if v.ID == "" {
		return d.Href("/orgs/" + v.OrgSlug + "/roles")
	}
	return d.Href("/orgs/" + v.OrgSlug + "/roles/" + v.ID)
}

func (v RoleEditView) page(d web.LayoutData) string {
	if v.ID == "" {
		return d.Href("/orgs/" + v.OrgSlug + "/roles/new")
	}
	return d.Href("/orgs/" + v.OrgSlug + "/roles/" + v.ID)
}

func (v RoleEditView) title(d web.LayoutData) string {
	if v.ID == "" {
		return d.Tr("role_edit.title_new")
	}
	return d.Tr("role_edit.title_edit", "Name", v.Name)
}

templ RoleEditPage(d web.LayoutData, v RoleEditView) {
	<section class="mx-auto max-w-xl">
		<header class="border-b border-border pb-4">
			<h1 class="text-2xl font-semibold text-foreground">{ v.title(d) }</h1>
			<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("role_edit.subtitle") }</p>
		</header>
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if v.Stale {
			<p class="mt-3 text-sm">
				<a href={ templ.SafeURL(v.page(d)) } class="font-medium text-primary underline underline-offset-2">{ d.Tr("role_edit.reload") }</a>
			</p>
		}
		<form method="post" action={ templ.SafeURL(v.action(d)) } class="mt-6 space-y-5 rounded-lg border border-border bg-card p-5 shadow-sm" novalidate>
			<button type="submit" class="sr-only" tabindex="-1" aria-hidden="true"></button>
			if v.ID != "" {
				<input type="hidden" name="version" value={ strconv.FormatInt(v.Version, 10) }/>
			}
			<div>
				<label class="block text-sm font-medium text-foreground/90" for="role-name">{ d.Tr("role_edit.name") }</label>
				<input id="role-name" name="name" type="text" dir="auto" required maxlength="40" autofocus?={ v.ID == "" } value={ v.Name } class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"/>
			</div>
			<div>
				<label class="block text-sm font-medium text-foreground/90" for="role-description">{ d.Tr("role_edit.description") }</label>
				<input id="role-description" name="description" type="text" dir="auto" value={ v.Description } class="mt-1.5 block w-full rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1"/>
			</div>
			<fieldset>
				<legend class="text-sm font-medium text-foreground/90">{ d.Tr("role_edit.permissions") }</legend>
				<p class="mt-1.5 flex flex-wrap items-center gap-1 text-sm text-muted-foreground">
					<span class="me-1">{ d.Tr("role_edit.copy_from") }</span>
					for _, b := range []string{"owner", "admin", "member"} {
						<button type="submit" formmethod="get" formaction={ templ.SafeURL(v.page(d)) } formnovalidate name="from" value={ b } class="rounded-md px-2 py-0.5 text-xs font-medium text-foreground hover:bg-muted">{ memberRoleLabel(d, b) }</button>
					}
				</p>
				<div class="mt-2 grid gap-2 rounded-md border border-border p-4 sm:grid-cols-2">
					for _, p := range v.Perms {
						<label class="flex min-h-11 items-center gap-3 text-sm text-foreground">
							<input type="checkbox" name="perm" value={ p.Value } checked?={ p.Checked } class="h-4 w-4 rounded border-border"/>
							<span class="first-letter:uppercase">{ p.Label }</span>
						</label>
					}
				</div>
			</fieldset>
			<div class="flex items-center gap-3 pt-2">
				<button type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">{ d.Tr("role_edit.save") }</button>
				<a href={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/roles")) } class="rounded-md px-4 py-2 text-sm font-medium text-foreground hover:bg-muted">{ d.Tr("role_edit.cancel") }</a>
			</div>
		</form>
	</section>
}

templ RoleEditLayout(d web.LayoutData, v RoleEditView) {
	@Layout(web.WithContent(d, RoleEditPage(d, v)))
}
