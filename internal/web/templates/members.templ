package templates

import (
	"altalune.id/opensheet/internal/web"
	"altalune.id/opensheet/internal/web/icons"
)

type MemberRow struct {
	UserID string
	Email  string
	Name   string
	Role      string
	RoleValue string
	RoleName  string
	System    bool
	// IsSelf marks the row belonging to the signed-in user, who cannot remove their own membership.
	IsSelf bool
	// Removable comes from org.RemovalRefusal, so the button only shows where the post would succeed.
	Removable    bool
	RoleEditable bool
	LastOwner    bool
	AllProjects  bool
	ProjectCount int
	Grant        *GrantView
	AccessOpen   bool
}

// GrantView is the state of one project-access fieldset: all projects, or the checked options.
type GrantView struct {
	All     bool
	Options []GrantOption
}

// GrantOption is one project checkbox in a project-access fieldset.
type GrantOption struct {
	ID      string
	Name    string
	Checked bool
}

type MembersView struct {
	OrgSlug        string
	OrgName        string
	Members        []MemberRow
	CanManage      bool
	CannotView     bool
	GrantableRoles []RoleOption
	ViewerIsOwner  bool
	RoleUpdated    bool
	AccessUpdated  bool
	Error          string
	ErrorCode      string
}

templ MembersPage(d web.LayoutData, v MembersView) {
	<section>
		<header class="flex items-baseline justify-between border-b border-border pb-4">
			<div>
				<h1 class="text-2xl font-semibold text-foreground">{ d.Tr("members.title") }</h1>
				<p class="mt-1 text-sm text-muted-foreground">{ d.Tr("members.subtitle") }</p>
			</div>
			if v.CanManage {
				<a href={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites")) } class="inline-flex items-center gap-2 rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90">
					@icons.Icon("user-plus", "h-4 w-4")
					<span>{ d.Tr("members.invite_button") }</span>
				</a>
			}
		</header>
		if v.CannotView {
			<p class="mt-6 rounded-md border border-border bg-muted/40 px-4 py-3 text-sm text-muted-foreground">{ d.Tr("members.view_denied") }</p>
		}
		if !v.CanManage && !v.CannotView {
			<p class="mt-6 rounded-md border border-border bg-muted/40 px-4 py-3 text-sm text-muted-foreground">{ d.Tr("members.read_only") }</p>
		}
		if v.RoleUpdated {
			<p data-notice="role-updated" class="mt-6 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900 dark:border-emerald-500/25 dark:bg-emerald-500/10 dark:text-emerald-200">
				@icons.Icon("check", "mr-1.5 inline h-4 w-4 align-text-bottom")
				{ d.Tr("members.role_updated") }
			</p>
		}
		if v.AccessUpdated {
			<p data-notice="access-updated" class="mt-6 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900 dark:border-emerald-500/25 dark:bg-emerald-500/10 dark:text-emerald-200">
				@icons.Icon("check", "mr-1.5 inline h-4 w-4 align-text-bottom")
				{ d.Tr("members.access_updated") }
			</p>
		}
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if !v.CannotView {
			<ul class="mt-6 divide-y divide-border/50 overflow-hidden rounded-lg border border-border bg-card shadow-sm">
				if len(v.Members) == 0 {
					<li class="px-4 py-6 text-center text-sm text-muted-foreground">{ d.Tr("members.empty") }</li>
				}
				for _, m := range v.Members {
					<li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
						<div class="min-w-0">
							<p class="flex items-center gap-2 truncate text-sm font-medium text-foreground">
								<span class="truncate">
									if m.Name != "" {
										{ m.Name }
									} else {
										{ m.Email }
									}
								</span>
								if m.IsSelf {
									<span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">{ d.Tr("members.you") }</span>
								}
							</p>
							<p class="truncate text-xs text-muted-foreground">
								{ m.Email } · { memberRowRole(d, m) } · <span data-access>{ memberAccess(d, v, m) }</span>
								if m.System {
									<span class="ml-2 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-500/15 dark:text-amber-300 dark:ring-amber-500/25">{ d.Tr("common.system") }</span>
								}
							</p>
						</div>
						if v.CanManage && (m.RoleEditable || m.LastOwner || m.Removable || m.Grant != nil) {
							<div class="group/access flex min-w-0 max-w-full flex-wrap items-center justify-end gap-2">
								if m.LastOwner {
									<select disabled aria-label={ d.Tr("members.role_for", "Name", memberLabel(m)) } aria-describedby={ "last-owner-" + m.UserID } class="cursor-not-allowed rounded-md border border-border bg-card px-2 py-1 text-sm text-muted-foreground opacity-60 shadow-sm">
										<option>{ d.Tr("members.role_owner") }</option>
									</select>
									<p id={ "last-owner-" + m.UserID } class="basis-full text-start text-xs text-muted-foreground sm:text-end">
										if v.ViewerIsOwner {
											{ d.Tr("authz.last_owner", "Org", v.OrgName) }
										} else {
											{ d.Tr("members.last_owner_owner_only") }
										}
									</p>
								} else if m.RoleEditable {
									@memberRoleForm(d, v, m)
								}
								if m.Removable {
									<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/members/" + m.UserID + "/remove")) } class="inline">
										<button type="submit" aria-label={ "Remove " + m.Email } class="rounded p-1.5 text-muted-foreground/70 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/40 dark:hover:text-red-400">
											@icons.Icon("trash-2", "h-4 w-4")
										</button>
									</form>
								}
								if m.Grant != nil {
									@memberAccessForm(d, v, m)
								}
							</div>
						}
					</li>
				}
			</ul>
		}
	</section>
}

func memberLabel(m MemberRow) string {
	if m.Name != "" {
		return m.Name
	}
	return m.Email
}

func memberRoleLabel(d web.LayoutData, role string) string {
	switch role {
	case "owner":
		return d.Tr("members.role_owner")
	case "admin":
		return d.Tr("invites.role_admin")
	default:
		return d.Tr("invites.role_member")
	}
}

func roleOptionLabel(d web.LayoutData, o RoleOption) string {
	if o.Label != "" {
		return o.Label
	}
	return memberRoleLabel(d, o.Value)
}

func memberRowRole(d web.LayoutData, m MemberRow) string {
	switch {
	case m.RoleName != "":
		return m.RoleName
	case m.Role == "custom":
		return d.Tr("members.role_custom")
	}
	return m.Role
}

templ memberRoleForm(d web.LayoutData, v MembersView, m MemberRow) {
	<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/members/" + m.UserID + "/role")) } class="flex items-center gap-2">
		<select name="role" required aria-label={ d.Tr("members.role_for", "Name", memberLabel(m)) } class="rounded-md border border-border bg-card px-2 py-1 text-sm text-foreground shadow-sm focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-1">
			if !roleListed(v.GrantableRoles, m.RoleValue) {
				<option value="" selected disabled>{ memberRowRole(d, m) }</option>
			}
			for _, o := range v.GrantableRoles {
				<option value={ o.Value } selected?={ m.RoleValue == o.Value }>{ roleOptionLabel(d, o) }</option>
			}
		</select>
		<button type="submit" class="rounded-md border border-border bg-card px-2.5 py-1 text-sm font-medium text-foreground shadow-sm hover:bg-muted">{ d.Tr("members.save_role") }</button>
	</form>
}

func roleListed(options []RoleOption, value string) bool {
	for _, o := range options {
		if o.Value == value {
			return true
		}
	}
	return false
}

func memberAccess(d web.LayoutData, v MembersView, m MemberRow) string {
	switch {
	case m.Role == "owner" || m.AllProjects:
		return d.Tr("members.access_all")
	case v.CanManage:
		return d.TrN("members.access_count", m.ProjectCount)
	}
	return d.Tr("members.access_some_label")
}

templ memberAccessForm(d web.LayoutData, v MembersView, m MemberRow) {
	<details open?={ m.AccessOpen } class="basis-full text-sm group-has-[option[value=owner]:checked]/access:hidden">
		<summary class="cursor-pointer select-none text-end text-xs text-muted-foreground hover:text-foreground">{ memberAccess(d, v, m) }</summary>
		<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/members/" + m.UserID + "/projects")) } aria-label={ d.Tr("members.access_for", "Name", memberLabel(m)) } class="mt-2 space-y-2 rounded-md border border-border p-3">
			@ProjectGrantFields(memberGrantCopy(d), *m.Grant, "")
			<button type="submit" class="rounded-md border border-border bg-card px-2.5 py-1 text-sm font-medium text-foreground shadow-sm hover:bg-muted">{ d.Tr("members.save_access") }</button>
		</form>
	</details>
	<p class="hidden basis-full text-end text-xs text-muted-foreground group-has-[option[value=owner]:checked]/access:block">{ d.Tr("members.access_owner") }</p>
}

// GrantCopy is the text of a project-access fieldset; Empty, when set, replaces the picker in an org with no projects.
type GrantCopy struct {
	Legend, All, Some, Hint, Empty string
}

func memberGrantCopy(d web.LayoutData) GrantCopy {
	return GrantCopy{Legend: d.Tr("members.access_label"), All: d.Tr("members.access_all"), Some: d.Tr("members.access_some"), Hint: d.Tr("members.access_hint"), Empty: d.Tr("members.access_no_projects")}
}

// ProjectGrantFields is the "All projects" / "Only these projects" picker shared by invites, member edit and API keys.
templ ProjectGrantFields(c GrantCopy, g GrantView, listID string) {
	<fieldset class="group">
		<legend class="block text-sm font-medium text-foreground/90">{ c.Legend }</legend>
		if len(g.Options) == 0 && c.Empty != "" {
			<input type="hidden" name="grant" value="all"/>
			<p class="mt-1 text-xs text-muted-foreground">{ c.Empty }</p>
		} else {
			<div class="mt-1.5 flex flex-wrap gap-2">
				<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border px-3 py-1 text-sm text-foreground/90 hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/10">
					<input type="radio" name="grant" value="all" checked?={ g.All } class="h-3.5 w-3.5"/>
					<span>{ c.All }</span>
				</label>
				<label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-border px-3 py-1 text-sm text-foreground/90 hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/10">
					<input type="radio" name="grant" value="selected" checked?={ !g.All } class="h-3.5 w-3.5"/>
					<span>{ c.Some }</span>
				</label>
			</div>
			@ProjectGrantList(listID, g.Options)
			<p class="mt-1 text-xs text-muted-foreground group-has-[input[value=all]:checked]:hidden">{ c.Hint }</p>
		}
	</fieldset>
}

// ProjectGrantList is the checkbox list of ProjectGrantFields; the personal token form swaps it by id when its org changes.
templ ProjectGrantList(id string, options []GrantOption) {
	<div
		if id != "" {
			id={ id }
		}
		class="mt-2 flex flex-wrap gap-2 group-has-[input[value=all]:checked]:hidden"
	>
		for _, o := range options {
			<label class="inline-flex min-w-0 cursor-pointer items-center gap-2 rounded-full border border-border px-3 py-1 text-sm text-foreground/90 hover:bg-muted has-[:checked]:border-primary has-[:checked]:bg-primary/10">
				<input type="checkbox" name="project_ids" value={ o.ID } checked?={ o.Checked } class="h-3.5 w-3.5 shrink-0 rounded border-border"/>
				<span class="max-w-[14rem] truncate">{ o.Name }</span>
			</label>
		}
	</div>
}

templ MembersLayout(d web.LayoutData, v MembersView) {
	@Layout(web.WithContent(d, MembersPage(d, v)))
}
