index opensheet_api_key_sheets_org_idx
CREATE INDEX opensheet_api_key_sheets_org_idx
  ON opensheet_api_key_sheets (org_id)

index opensheet_api_key_sheets_sheet_idx
CREATE INDEX opensheet_api_key_sheets_sheet_idx
  ON opensheet_api_key_sheets (sheet_id)

index opensheet_api_keys_org_project_idx
CREATE INDEX opensheet_api_keys_org_project_idx
  ON opensheet_api_keys (org_id, project_id)

index opensheet_credentials_authorized_by_idx
CREATE INDEX opensheet_credentials_authorized_by_idx
  ON opensheet_credentials (authorized_by_user_id)

index opensheet_credentials_org_project_idx
CREATE INDEX opensheet_credentials_org_project_idx
  ON opensheet_credentials (org_id, project_id)

index opensheet_invites_email_pending_idx
CREATE INDEX opensheet_invites_email_pending_idx
  ON opensheet_invites (email)
  WHERE accepted_at IS NULL

index opensheet_memberships_user_idx
CREATE INDEX opensheet_memberships_user_idx
  ON opensheet_memberships (user_id)

index opensheet_sessions_expires_idx
CREATE INDEX opensheet_sessions_expires_idx
  ON opensheet_sessions (expires_at)

index opensheet_sessions_user_idx
CREATE INDEX opensheet_sessions_user_idx
  ON opensheet_sessions (user_id)

index opensheet_sheet_snapshots_expires_idx
CREATE INDEX opensheet_sheet_snapshots_expires_idx
  ON opensheet_sheet_snapshots (expires_at)

index opensheet_sheet_snapshots_org_project_idx
CREATE INDEX opensheet_sheet_snapshots_org_project_idx
  ON opensheet_sheet_snapshots (org_id, project_id)

index opensheet_sheet_write_attempts_expires_idx
CREATE INDEX opensheet_sheet_write_attempts_expires_idx
  ON opensheet_sheet_write_attempts (expires_at)

index opensheet_sheet_write_attempts_org_project_idx
CREATE INDEX opensheet_sheet_write_attempts_org_project_idx
  ON opensheet_sheet_write_attempts (org_id, project_id)

index opensheet_sheets_org_project_idx
CREATE INDEX opensheet_sheets_org_project_idx
  ON opensheet_sheets (org_id, project_id)

index opensheet_sheets_spreadsheet_idx
CREATE INDEX opensheet_sheets_spreadsheet_idx
  ON opensheet_sheets (spreadsheet_id)

index opensheet_spreadsheets_credential_idx
CREATE INDEX opensheet_spreadsheets_credential_idx
  ON opensheet_spreadsheets (credential_id)

index opensheet_spreadsheets_org_project_idx
CREATE INDEX opensheet_spreadsheets_org_project_idx
  ON opensheet_spreadsheets (org_id, project_id)

index opensheet_todos_org_project_created_idx
CREATE INDEX opensheet_todos_org_project_created_idx
  ON opensheet_todos (org_id, project_id, created_at DESC)

index opensheet_todos_org_stale_idx
CREATE INDEX opensheet_todos_org_stale_idx
  ON opensheet_todos (org_id, created_at)
  WHERE done = 0

index opensheet_users_idp_idx
CREATE UNIQUE INDEX opensheet_users_idp_idx
  ON opensheet_users (idp_issuer, idp_subject)
  WHERE idp_issuer IS NOT NULL

table opensheet_api_key_sheets
CREATE TABLE opensheet_api_key_sheets (
  api_key_id          TEXT NOT NULL REFERENCES opensheet_api_keys(id) ON DELETE CASCADE,
  sheet_id            TEXT NOT NULL REFERENCES opensheet_sheets(id) ON DELETE CASCADE,
  -- Mirrors the Postgres table, whose org_id exists so the join table can carry its own RLS policy.
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  PRIMARY KEY (api_key_id, sheet_id)
)

table opensheet_api_keys
CREATE TABLE opensheet_api_keys (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id          TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  name                TEXT NOT NULL,
  key_prefix          TEXT NOT NULL UNIQUE,
  -- SECURITY: SHA-256 of the 256-bit secret half. The plaintext key is returned once, at mint, and never stored.
  secret_hash         BLOB NOT NULL,
  -- JSON array of scope strings; SQLite has no array type.
  scopes              TEXT NOT NULL DEFAULT '[]',
  expires_at          TEXT,
  last_used_at        TEXT,
  revoked_at          TEXT,
  created_at          TEXT NOT NULL
)

table opensheet_bootstrap
CREATE TABLE opensheet_bootstrap (
  id            INTEGER PRIMARY KEY CHECK (id = 1),
  onboarded_at  DATETIME NOT NULL,
  onboarded_by  TEXT NOT NULL REFERENCES opensheet_users(id),
  method        TEXT NOT NULL CHECK (method IN ('env-genesis','web-onboard','cli-init'))
)

table opensheet_credentials
CREATE TABLE opensheet_credentials (
  id                    TEXT PRIMARY KEY,
  org_id                TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id            TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  name                  TEXT NOT NULL,
  kind                  TEXT NOT NULL CHECK (kind IN ('service_account','google_oauth')),
  status                TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','reauth_needed')),
  authorized_by_user_id TEXT NOT NULL REFERENCES opensheet_users(id),
  google_account_email  TEXT NOT NULL DEFAULT '',
  -- SECURITY: ciphertext only, sealed with AAD org_id||project_id||id — a row moved to another tenant cannot be opened.
  sealed                BLOB NOT NULL,
  created_at            TEXT NOT NULL,
  updated_at            TEXT NOT NULL,
  UNIQUE (project_id, name)
)

table opensheet_invites
CREATE TABLE opensheet_invites (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  email               TEXT NOT NULL,
  role                TEXT NOT NULL CHECK (role IN ('owner','admin','member')),
  token_hash          TEXT NOT NULL,
  expires_at          TEXT NOT NULL,
  accepted_at         TEXT,
  invited_by          TEXT NOT NULL REFERENCES opensheet_users(id),
  created_at          TEXT NOT NULL
)

table opensheet_memberships
CREATE TABLE opensheet_memberships (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  user_id             TEXT NOT NULL REFERENCES opensheet_users(id) ON DELETE CASCADE,
  role                TEXT NOT NULL CHECK (role IN ('owner','admin','member')),
  system              INTEGER NOT NULL DEFAULT 0,
  created_at          TEXT NOT NULL,
  UNIQUE (org_id, user_id)
)

table opensheet_orgs
CREATE TABLE opensheet_orgs (
  id                  TEXT PRIMARY KEY,
  slug                TEXT NOT NULL UNIQUE,
  name                TEXT NOT NULL,
  system              INTEGER NOT NULL DEFAULT 0,
  created_by          TEXT NOT NULL REFERENCES opensheet_users(id),
  created_at          TEXT NOT NULL,
  updated_at          TEXT NOT NULL
)

table opensheet_projects
CREATE TABLE opensheet_projects (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  slug                TEXT NOT NULL,
  name                TEXT NOT NULL,
  system              INTEGER NOT NULL DEFAULT 0,
  created_by          TEXT NOT NULL REFERENCES opensheet_users(id),
  created_at          TEXT NOT NULL,
  updated_at          TEXT NOT NULL,
  UNIQUE (org_id, slug)
)

table opensheet_sessions
CREATE TABLE opensheet_sessions (
  sid         TEXT PRIMARY KEY,
  user_id     TEXT NOT NULL REFERENCES opensheet_users(id) ON DELETE CASCADE,
  -- SECURITY: sealed Principal, AAD-bound to sid — it carries a live IdP ID token.
  payload     BLOB NOT NULL,
  expires_at  TEXT NOT NULL,
  created_at  TEXT NOT NULL
)

table opensheet_sheet_snapshots
CREATE TABLE opensheet_sheet_snapshots (
  sheet_id            TEXT NOT NULL REFERENCES opensheet_sheets(id) ON DELETE CASCADE,
  -- The RESOLVED tab name, never '', so renaming the first tab cannot keep serving the old one.
  tab                 TEXT NOT NULL,
  etag                TEXT NOT NULL,
  -- BLOB, not TEXT: the etag hashes these exact bytes, so they must round-trip unchanged.
  payload             BLOB NOT NULL,
  fetched_at          TEXT NOT NULL,
  expires_at          TEXT NOT NULL,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id          TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  PRIMARY KEY (sheet_id, tab)
)

table opensheet_sheet_write_attempts
CREATE TABLE opensheet_sheet_write_attempts (
  sheet_id            TEXT NOT NULL REFERENCES opensheet_sheets(id) ON DELETE CASCADE,
  tab                 TEXT NOT NULL,
  -- NOTE: idem_key, not key: `ON CONFLICT (sheet_id, tab, key)` beside `SET key = key` reads as a trap.
  idem_key            TEXT NOT NULL,
  body_hash           TEXT NOT NULL,
  -- NOTE: nullable, because the no-op DO UPDATE returns the freshly inserted row on the claimed path, where no payload exists yet.
  payload             BLOB,
  done                INTEGER NOT NULL,
  claim_token         TEXT NOT NULL,
  created_at          TEXT NOT NULL,
  expires_at          TEXT NOT NULL,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id          TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  PRIMARY KEY (sheet_id, tab, idem_key)
)

table opensheet_sheets
CREATE TABLE opensheet_sheets (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id          TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  spreadsheet_id      TEXT NOT NULL REFERENCES opensheet_spreadsheets(id) ON DELETE CASCADE,
  -- Empty tab means "the spreadsheet's first tab", resolved at read time.
  tab                 TEXT NOT NULL DEFAULT '',
  slug                TEXT NOT NULL,
  visibility          TEXT NOT NULL DEFAULT 'key' CHECK (visibility IN ('key','public')),
  -- 0 means "use cache.defaultTTL"; the aggregate otherwise bounds it to [1s, 24h].
  cache_ttl_secs      INTEGER NOT NULL DEFAULT 0 CHECK (cache_ttl_secs >= 0 AND cache_ttl_secs <= 86400),
  created_at          TEXT NOT NULL,
  updated_at          TEXT NOT NULL, writable INTEGER NOT NULL DEFAULT 0,
  UNIQUE (project_id, slug)
)

table opensheet_spreadsheets
CREATE TABLE opensheet_spreadsheets (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id          TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  -- RESTRICT, not CASCADE: deleting a credential that still reads documents must fail loudly as CRD005.
  credential_id       TEXT NOT NULL REFERENCES opensheet_credentials(id) ON DELETE RESTRICT,
  google_file_id      TEXT NOT NULL,
  title               TEXT NOT NULL DEFAULT '',
  created_at          TEXT NOT NULL,
  updated_at          TEXT NOT NULL, writable INTEGER NOT NULL DEFAULT 0,
  UNIQUE (project_id, google_file_id)
)

table opensheet_todos
CREATE TABLE opensheet_todos (
  id                  TEXT PRIMARY KEY,
  org_id              TEXT NOT NULL REFERENCES opensheet_orgs(id) ON DELETE CASCADE,
  project_id          TEXT NOT NULL REFERENCES opensheet_projects(id) ON DELETE CASCADE,
  user_id             TEXT NOT NULL REFERENCES opensheet_users(id),
  title               TEXT NOT NULL,
  done                INTEGER NOT NULL DEFAULT 0,
  created_at          TEXT NOT NULL,
  updated_at          TEXT NOT NULL
)

table opensheet_users
CREATE TABLE opensheet_users (
  id                  TEXT PRIMARY KEY,
  idp_issuer          TEXT,
  idp_subject         TEXT,
  email               TEXT NOT NULL UNIQUE,
  name                TEXT NOT NULL DEFAULT '',
  avatar_url          TEXT NOT NULL DEFAULT '',
  password_hash       TEXT NOT NULL DEFAULT '',
  is_admin            INTEGER NOT NULL DEFAULT 0,
  locale              TEXT NOT NULL DEFAULT '',
  terms_accepted_at   TEXT,
  created_at          TEXT NOT NULL,
  updated_at          TEXT NOT NULL
)

