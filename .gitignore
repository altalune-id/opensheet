# Binaries and build output
/bin/
/dist/
*.exe

# Test + coverage
*.out
*.test
coverage.*
.cover/

# Environment
.env
.env.local
.env.*
!.env.example

# Signing artifacts and keys
*.sig
*.pem

# Local state
*.db
*.db-journal
~/.opensheet/

# Editor
.idea/
*.swp
.DS_Store

# Node toolchain (pnpm-managed buf CLI)
node_modules/
.pnpm-store/

# SDD workspace (scratch, not shipped)
/.superpowers/
/docs/superpowers/
/docs/specs/
/docs/plans/

# App data
.opensheet-data
.cache

# Local make timestamp; the vendored UI assets themselves are committed.
/internal/web/static/.vendor-stamp

# Debugging / profiling
*.prof
.playwright-mcp

# Local compose stack data (postgres bind mount, etc.).
# Track the dir via .gitkeep, ignore every child (pg, future subdirs).
/docker/data/*
!/docker/data/.gitkeep
